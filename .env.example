VITE_APP_TITLE=PAEC

# Local: relative /api is proxied by Vite to VITE_APP_URL (Laravel).
# Vercel → Hostinger: set absolute Hostinger API URL (see .env.vercel.example).
# Services call /v1/..., so this must end at /api (not /api/v1).
VITE_API_BASE_URL=/api

# Local UI origin (Open Graph / meta).
VITE_FRONTEND_URL=http://localhost:3000

# Local only — must match Laravel APP_URL (used by Vite /api proxy).
# Not used in production builds.
VITE_APP_URL=http://127.0.0.1:8000
