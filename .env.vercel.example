# Copy into Vercel → Project → Settings → Environment Variables
# (Production), then Redeploy. Vite bakes these in at build time.

VITE_APP_TITLE=PAEC

# MUST point at the Hostinger Laravel API and end at /api
# (PAEC services call /v1/... on top of this base).
VITE_API_BASE_URL=https://your-paec-site.hostingersite.com/api

VITE_FRONTEND_URL=https://your-paec-app.vercel.app
