VITE_APP_TITLE=PAEC

# Relative so API calls go through the Vite proxy (VITE_APP_URL) locally.
VITE_API_BASE_URL=/api

# Local UI origin (Open Graph / meta).
VITE_FRONTEND_URL=http://localhost:3000

# Local only — must match Laravel APP_URL (used by Vite /api proxy).
# Not used in production builds.
VITE_APP_URL=http://127.0.0.1:8000
